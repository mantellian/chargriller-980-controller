# Example secrets file for Char-Griller 980 ESPHome controller.
# Copy this file to 'secrets.yaml' in this same directory and replace with your actual values:
#   cp secrets.yaml.example secrets.yaml

# WiFi Settings
wifi_ssid: "MyHomeWiFi"
wifi_password: "MySecretPassword123"

# ESPHome Native API Encryption (generate with `openssl rand -base64 32`)
api_encryption_key: "GENERATE_A_BASE64_KEY_HERE="

# OTA Firmware Update Password
ota_password: "ChooseAnOtaPassword"

# Built-in ESPHome Web Server Authentication (added in v0.3)
web_username: "admin"
web_password: "ChooseAStrongPassword"
